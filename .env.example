# Arkheia MCP server: environment variables.
# Detection runs on Arkheia's servers; this package sends the response and returns the signal.
# NEVER commit a .env file with real values.

# Required: your Arkheia API key (get one with the /v1/provision call in README.md).
ARKHEIA_API_KEY=

# Optional: the hosted API. Leave unset to use Arkheia's production service.
# ARKHEIA_HOSTED_URL=https://arkheia-proxy-production.up.railway.app

# Optional: only if you run your own Arkheia proxy. Leave unset otherwise.
# ARKHEIA_PROXY_URL=
