{
  "name": "@arkheia/mcp-server",
  "version": "1.3.0",
  "description": "Arkheia MCP Server — Fabrication detection for AI agents. Know when your AI is making things up.",
  "main": "dist/index.js",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && tsc -p tsconfig.test.json && node --test .test-build/test/egress.test.js .test-build/test/feedback.test.js .test-build/test/hardening.test.js .test-build/test/http.test.js .test-build/test/install.test.js .test-build/test/static.test.js .test-build/test/stdio.test.js .test-build/test/assessment.test.js .test-build/test/provider-response.test.js",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/setup.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "CLAUDE_MD_TEMPLATE.md"
  ],
  "keywords": [
    "mcp",
    "ai",
    "fabrication",
    "detection",
    "hallucination",
    "governance"
  ],
  "author": "Arkheia AI (https://arkheia.ai)",
  "bugs": {
    "url": "https://github.com/arkheiaai/arkheia-mcp/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "sql.js": "^1.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3"
  }
}
